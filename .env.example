# ==============================================================================
# CASHWISE - ENVIRONMENT VARIABLES CONFIGURATION EXAMPLE
# Copy this file to .env and configure values for your environment
# ==============================================================================

# MongoDB Connection String (Local instance or Atlas)
MONGODB_URI="mongodb://localhost:27017/cashwise"

# Application Public Base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000/api"

# JWT Secret for Session & Access Tokens
NEXTAUTH_SECRET="your-super-secret-jwt-key-change-in-production"

# ImageKit Configuration (for CDN report storage and receipts)
IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/..."

# Nodemailer / Gmail SMTP Configuration (for Scheduled Reports & Notifications)
EMAIL_USER="itofficepulse@gmail.com"
EMAIL_PASS="your-16-character-gmail-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Automated Report Defaults (used as fallbacks if not configured in Settings UI)
AUTO_EXPENSE_REPORT_TO="itofficepulse@gmail.com"
AUTO_EXPENSE_REPORT_TIMEZONE="Asia/Kolkata"

# Secret Key for Protecting Cron Webhook Endpoint (/api/cron/expense-reports)
CRON_SECRET="your-secret-cron-token"

# Optional SMS / Encryption keys
FAST2SMS=""
SOME_32BYTE_BASE64_STRING="4uWob+n6L++9/JtB5HvQ+OyZB4Pi7KMkg7GydoRMQQY="
SOME_64BYTE_BASE64_STRING="y69tVyfmFs9QeixuP5jdzUfXZ6h7u6BSt5iBB7ynmSWSlwkFpaFvD+AtgdrORuLIk6HRDvNYZVw/04yDPAVOyQ=="
